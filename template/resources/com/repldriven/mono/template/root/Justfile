set shell := ["zsh", "-cu"]

DOMAIN_ALIASES := ":+example"

list:
    just --list

# Check the native toolchain on PATH against what mono {{mono/tag}} requires.
# The versions below were stamped in at generation time; flake.nix provides
# them, and this is what tells you what is wrong when it is not active.
doctor:
    #!/usr/bin/env bash
    set -uo pipefail
    fail=0
    check() {
      local name="$1" want="$2" got="$3"
      if [ -z "$got" ]; then
        printf '  %-19s \033[31mmissing\033[0m (need %s)\n' "$name" "$want"
        fail=1
      elif [ "$got" = "$want" ]; then
        printf '  %-19s \033[32m%s\033[0m\n' "$name" "$got"
      else
        printf '  %-19s \033[31m%s\033[0m (need %s)\n' "$name" "$got" "$want"
        fail=1
      fi
    }
    echo "Native toolchain, against mono {{mono/tag}}:"
    check foundationdb "{{toolchain/fdb-version}}" \
      "$(fdbcli --version 2>/dev/null | sed -n '1s/.*(v\([0-9.]*\)).*/\1/p')"
    check protoc "{{toolchain/protoc-version}}" \
      "$(protoc --version 2>/dev/null | awk '{print $2}')"
    check protoc-gen-clojure "{{toolchain/protoc-gen-clojure-version}}" \
      "$(protoc-gen-clojure -v 2>/dev/null | sed -n 's/.*v\([0-9.]*\).*/\1/p')"
    if [ "$fail" -ne 0 ]; then
      echo
      echo "Run 'direnv allow' to get these from flake.nix, or install them at"
      echo "the versions above. A mismatched FoundationDB client cannot talk to"
      echo "the test cluster, and a newer protoc emits protobuf 4 code that the"
      echo "FDB Record Layer this release pins cannot load."
      echo
      echo "If you do not use FoundationDB, see the readme on removing the"
      echo "example bricks; these prerequisites go away with them."
      exit 1
    fi

# One-off after generating this workspace: run protobuf codegen. Required
# before any classpath will build, because example-bookmark declares
# :deps/prep-lib and its "classes" path does not exist until prep has run.
setup:
    clojure -X:deps prep :aliases '[{{ DOMAIN_ALIASES }} :dev]'

# Start nREPL server
repl:
    find . -name .nrepl-port -not -path ./.nrepl-port -delete
    clojure -M{{ DOMAIN_ALIASES }}:dev:test:nrepl -Sforce -P

# Start Rebel Readline REPL
rebel:
    clj -M{{ DOMAIN_ALIASES }}:dev:test:rebel

# Start polylith shell
shell:
    clj -M:poly shell

# Check the workspace
check:
    clojure -M:poly check

# Build all polylith projects as uberjars
build snapshot="true":
    #!/usr/bin/env zsh
    for project in projects/*/; do
        echo "Building ${project:t}..."
        (cd "$project" && clojure -X:build uber :snapshot {{ snapshot }})
    done

# Run all polylith project tests
test: start-docker
    clojure -M:poly test :all

# Linter
lint:
    clojure -M:lint/clj-kondo --lint bases components projects deps.edn workspace.edn

# Formatter - uses .zprint.edn config in project root
format:
    #!/usr/bin/env bash
    set -e
    echo "Formatting Clojure source files..."
    files=$(git ls-files '*.clj' '*.cljc' '*.cljs' | while read f; do [ -f "$f" ] && echo "$f"; done)
    if [ -n "$files" ]; then
        echo "$files" | xargs clojure -M:format/zprint '{:search-config? true}' -w
        echo "✓ Formatting complete"
    else
        echo "No Clojure files found"
    fi

force-prep:
    clojure -X:deps prep :aliases '[{{ DOMAIN_ALIASES }} :dev]' :force true

# Start Docker via Colima
start-docker:
    colima status 2>/dev/null || colima start --arch aarch64 --vm-type vz --vz-rosetta --cpu 6 --memory 12
    docker context use colima

# Stop Docker via Colima
stop-docker:
    colima stop
