source_up_if_exists

# The devshell in flake.nix provides a JDK, the Clojure CLI, just and Docker.
# That is the whole toolchain: the starter is postgres-backed and has no code
# generation step.
#
# Without nix, install those yourself — `just doctor` reports what is
# missing.
if has nix; then
  use flake .
else
  echo "nix not found — 'just doctor' will report what this workspace needs."
  echo "To install nix: https://nixos.org/download"
fi

# No prep step here: nothing in the starter generates code. If you add a
# brick that does, `just setup` runs it.
