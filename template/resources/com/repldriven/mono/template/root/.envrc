source_up_if_exists

# The devshell in flake.nix provides the pinned native toolchain: the
# FoundationDB client, protoc, and protoc-gen-clojure at exactly the versions
# the mono release this workspace pins was built against.
#
# Without nix you must put those on PATH yourself, at those versions — the
# readme's prerequisites section lists them, and `just doctor` checks what you
# have against what is required.
if has nix; then
  use flake .
else
  echo "nix not found — 'just doctor' will report what this workspace needs."
  echo "To install nix: https://nixos.org/download"
fi

# Codegen is not run here. It is a one-off after generation and after any
# change to a .proto, so it stays an explicit `just setup`.
